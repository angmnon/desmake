loglevel=error

# R2-Low: use the official npm registry, not a third-party mirror. A mirror is an
# extra party in the supply chain that can serve a substituted tarball; even with
# integrity hashes in the lockfile, keeping the source of truth canonical removes
# the ambiguity. (Verified reachable from the build environment.)
registry=https://registry.npmjs.org/

# R2/H7: `strictStorePkgContentCheck=false` and `verifyStoreIntegrity=false` were
# removed. They disable pnpm's tarball integrity verification, which is the exact
# control that stops a tampered/poisoned package in the store or on the mirror from
# being installed silently. Integrity checking stays ON.

# 网络优化
network-concurrency=16
fetch-retries=3
fetch-timeout=60000

# 严格使用 peer dependencies
strict-peer-dependencies=false

# 自动生成 lockfile
auto-install-peers=true

# lockfile 配置
lockfile=true
prefer-frozen-lockfile=true

# R2-Low: `highest` silently upgraded transitive deps to the newest matching
# version on each install, so two builds from the same lockfile could resolve
# different trees. `lowest-direct` is pnpm's reproducible default: pick the lowest
# satisfying version and let the lockfile pin everything else.
resolution-mode=lowest-direct

# 不提示 npm 更新
update-notifier=false
