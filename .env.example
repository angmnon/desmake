# Desmake — environment configuration (example)
# Copy to `.env` / `.env.local` and adjust as needed. No secrets are required
# for the MVP: sessions are random tokens held in an in-memory Map, and prices
# are derived server-side from static seed data (no external API keys).

# Runtime mode. "production" enables prod behaviour (httpOnly cookie `secure`,
# the custom server runs the prebuilt `.next` instead of `next dev`).
NODE_ENV=development

# Coze deploy compatibility flag. "PROD" forces production mode in the custom
# server (src/server.ts) even when NODE_ENV is not "production". Required by
# scripts/start.sh.
COZE_PROJECT_ENV=PROD

# HTTP port for the custom server (src/server.ts reads PORT). The Coze deploy
# layer injects DEPLOY_RUN_PORT, which scripts/start.sh maps onto PORT.
PORT=5000
DEPLOY_RUN_PORT=5000
