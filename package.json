{
  "name": "desmake",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "preinstall": "node scripts/check-pm.mjs",
    "build": "bash ./scripts/build.sh",
    "dev": "bash ./scripts/dev.sh",
    "lint": "eslint",
    "lint:build": "eslint . --quiet",
    "lint:style": "stylelint \"src/**/*.css\"",
    "start": "bash ./scripts/start.sh",
    "ts-check": "tsc -p tsconfig.json",
    "validate": "pnpm ts-check && pnpm lint:build && pnpm lint:style",
    "preview": "node scripts/gen-blog-content.mjs && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "node scripts/gen-blog-content.mjs && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.0.0",
    "@stripe/react-stripe-js": "^3.1.0",
    "@stripe/stripe-js": "^4.10.0",
    "aws4": "^1.13.2",
    "clsx": "^2.1.1",
    "lenis": "^1.3.26",
    "lucide-react": "^0.468.0",
    "next": "^16.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "stripe": "^17.5.0",
    "tailwind-merge": "^2.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.0",
    "stylelint": "^16.4.0",
    "stylelint-config-standard": "^38.0.0",
    "tailwindcss": "^4",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "wrangler": "^4.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9.0.0"
  }
}
